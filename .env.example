# where the rpc I started is running.

# RPC_URL=http://127.0.0.1:18089/json_rpc
RPC_URL=http://127.0.0.1:38089/json_rpc
# becomes https://website.com/secret123/webhook/set_website_fund_xmr
# the domain of where my website is running
WEBHOOK_TARGET_DOMAIN=https://website.com
WEBHOOK_SECRET_PATH_PREFIX=secret123
WEBHOOK_PATH=webhook
WEBHOOK_ACTION=set_website_fund_xmr
# the token my website accepts 
WEBHOOK_TOKEN=secret321


WEBHOOK_SEND_INTERVAL_SECONDS=60


# must be identical to cloudflare's rules, of course
CF_BYPASS_HEADER_NAME=x-bypass-token-secret-randomstr
CF_BYPASS_TOKEN=randomstr

# setting this to true will send an arbitrary value to the webhook, without calling monero rpc.
# I used this to test some webhook changes I made when I didn't want to pull up the whole monero cli thingie just to test something unrelated.
TEST_WEBHOOK_ONLY=false